#!/usr/bin/env ruby

require "shellwords"
require "socket"
require "rdoc"

require_relative "./github_api"
require_relative "./jira_api"
require_relative "./open-in-editor-bridge"
require_relative "./pull_request_editor"

class DevHelper
  # Support dashes in command names
  COMMAND_TO_METHOD = {
    "ts-node" => :ts_node,
    "check-types" => :check_types,
    "branch-from" => :branch_from,
    "changes-from" => :changes_from,
    "description-from" => :description_from,
    "edit-pr" => :edit_pr,
    "bash-completions" => :bash_completions,
    "plantuml-to-png" => :plantuml_to_png,
    "sqlcmd-query" => :sqlcmd_query,
  }.freeze

  PORT_ENV_FILE = ".dev-ports.env"
  PORT_ENV_KEYS = %w[
    TK_API_PORT
    TK_API_DEBUG_PORT
    TK_ARCHIVER_PORT
    TK_DB_PORT
    TK_MAIL_UI_PORT
    TK_MAIL_SMTP_PORT
    TK_REDIS_PORT
  ].freeze

  WEB_HOST_ENV_KEY = "TK_WEB_HOST"
  WEB_HOST_SUFFIX = ".tk.localhost"
  STACK_ID_ENV_KEY = "TK_STACK_ID"
  DEVELOPMENT_SERVICES = %w[
    api
    api_wait
    archiver
    cache
    db
    mail
    plantuml
    test_api
    test_web
    web
  ].freeze

  METHOD_TO_COMMAND = COMMAND_TO_METHOD.invert

  REPLACE_PROCESS = "replace_process"
  WAIT_FOR_PROCESS = "wait_for_process"

  # External Interface

  def self.call(*args)
    new.call(*args)
  end

  # Core logic

  def call(*args, **kwargs)
    command = args[0]
    method = COMMAND_TO_METHOD.fetch(command, command)
    if args.length.positive? && respond_to?(method)
      public_send(method, *args.drop(1), **kwargs)
    else
      compose(*args, **kwargs)
    end
  end

  def compose(*args, **kwargs)
    command = compose_command(*args, **kwargs)
    puts "Running: #{command}"

    case kwargs[:execution_mode]
    when WAIT_FOR_PROCESS
      system(command)
    else
      exec(command)
    end
  end

  # Primary command wrappers

  def build(*args, **kwargs)
    compose(%w[build], *args, **kwargs)
  end

  def up(*args, **kwargs)
    ensure_local_gateway! if gateway_needed?(args)
    ensure_development_ports!

    OpenInEditorBridge.with_running do
      compose(*%w[up --remove-orphans --force-recreate], *args, execution_mode: WAIT_FOR_PROCESS, **kwargs)
    end
  end

  def down(*args, **kwargs)
    OpenInEditorBridge.with_running(ensure_running: false) do
      compose(*%w[down --remove-orphans], *args, execution_mode: WAIT_FOR_PROCESS, **kwargs)
    end
  end

  def logs(*args, **kwargs)
    compose(*%w[logs -f], *args, **kwargs)
  end

  def run(*args, **kwargs)
    compose(*%w[run --rm], *args, **kwargs)
  end

  def ps(*args, **kwargs)
    compose(*%w[ps], *args, **kwargs)
  end

  # Custom helpers

  ##
  # Start a shell in the api container.
  def sh(*args, **kwargs)
    run(*%w[api sh], *args, **kwargs)
  end

  def debug(*args, **kwargs)
    compose("exec api node inspect localhost:9229", *args, **kwargs)
  end

  def web(*args, **kwargs)
    run(*%w[web], *args, **kwargs)
  end

  def api(*args, **kwargs)
    run(*%w[api], *args, **kwargs)
  end

  def archiver(*args, **kwargs)
    run(*%w[archiver], *args, **kwargs)
  end

  def npm(*args, **kwargs)
    run(*%w[api npm], *args, **kwargs)
  end

  def ts_node(*args, **kwargs)
    run(*%w[api npm run ts-node], *args, **kwargs)
  end

  def check_types(*args, **kwargs)
    run(*%w[api npm run check-types], *args, execution_mode: WAIT_FOR_PROCESS, **kwargs) &&
      run(*%w[web npm run check-types], *args, **kwargs)
  end

  def test(*args, **kwargs)
    service = args[0]
    if service == "api"
      test_api(*args.drop(1), **kwargs)
    elsif service == "web"
      test_web(*args.drop(1), **kwargs)
    else
      test_api(*args, **kwargs)
    end
  end

  def test_api(*args, **kwargs)
    reformat_project_relative_path_filter_for_vitest!(args, "api/")
    run(*%w[test_api npm run test], *args, **kwargs)
  end

  def test_web(*args, **kwargs)
    reformat_project_relative_path_filter_for_vitest!(args, "web/")
    run(*%w[test_web npm run test], *args, **kwargs)
  end

  def knex(*args, **kwargs)
    if RUBY_PLATFORM =~ /linux/
      run(*%w[api npm run knex], *args, execution_mode: WAIT_FOR_PROCESS, **kwargs)

      file_or_directory = "api/src/db"
      exit(0) unless take_over_needed?(file_or_directory)

      ownit file_or_directory
    else
      run(*%w[api npm run knex], *args, **kwargs)
    end
  end

  def migrate(*args, **kwargs)
    action = args[0]
    knex("migrate:#{action}", *args.drop(1), **kwargs)
  end

  def seed(*args, **kwargs)
    action = args[0]
    knex("seed:#{action}", *args.drop(1), **kwargs)
  end

  ##
  # Start the sqlcmd utility to interact with the database (interactive console).
  # -I enable quoted identifiers, e.g. "table"."column"
  #
  # For interactive database access:
  #   dev sqlcmd
  #
  # For direct queries and queries with special characters, see sqlcmd_query method.
  def sqlcmd(*args, **kwargs) # rubocop:disable Metrics/MethodLength
    environment_hoist = ENV.slice(*%w[
      DB_DATABASE
      DB_USERNAME
      DB_HOST
      DB_PORT
    ]).map { |key, value|
      "export #{key}=\"#{value}\""
    }.join("\n  ")

    tty_argument = ""
    tty_argument = "-T" if kwargs.fetch(:enable_tty, false)

    compose(
      <<~BASH,
        exec #{tty_argument} db sh -c '
          #{environment_hoist}
          /opt/mssql-tools18/bin/sqlcmd \
            -U "$DB_USERNAME" \
            -P "$DB_PASSWORD" \
            -H "$DB_HOST" \
            -d "$DB_DATABASE" \
            -C \
            -I #{args.join(" ")}
          '
      BASH
      **kwargs
    )
  end

  ##
  # Execute SQL query directly using sqlcmd.
  #
  # For simple queries without special characters:
  #   dev sqlcmd-query "SELECT COUNT(*) FROM users"
  #   dev sqlcmd-query "SELECT id, name FROM external_organizations WHERE id = 12"
  #
  # For queries with special characters (single quotes, Unicode, Indigenous names), use here documents with sqlcmd:
  #   cat << 'SQL' | ./bin/dev sqlcmd
  #   SELECT id, name FROM external_organizations WHERE name = 'Tr''ondëk Hwëch''in';
  #   SQL
  #
  # This approach handles:
  # - Single quotes (escape with double single quotes: '')
  # - Unicode characters (ë, ü, etc.)
  # - Complex multi-line queries
  # - Indigenous names with special characters
  #
  # Usage patterns:
  # - Use sqlcmd_query for direct queries without special characters
  # - Use here documents with sqlcmd for problematic queries
  # - Use sqlcmd for interactive database console access
  def sqlcmd_query(query, *args, **kwargs)
    if query.nil? || query.strip.empty?
      raise ArgumentError, "Query cannot be nil or empty"
    end

    sqlcmd(args, enable_tty: true, pipe_input: query, **kwargs)
  end

  def db(*args, **kwargs)
    compose(*%w[exec db], *args, **kwargs)
  end

  ##
  # Generates and checks out a new Git branch based on a Jira or GitHub issue URL.
  #
  # Example:
  #
  #   dev branch-from https://yg-hpw.atlassian.net/browse/ELCC-61
  #   #=> git checkout -b elcc-61/add-wage-enhancement-replication-across-months
  #
  #   dev branch-from https://github.com/icefoganalytics/internal-data-portal/issues/98
  #   #=> git checkout -b issue-98/switch-test-suite-from-jest-to-vitest
  #
  def branch_from(jira_or_github_issue_url, *args, **kwargs)
    if jira_or_github_issue_url.include?("atlassian.net")
      branch_name = JiraApi.build_branch_name(jira_or_github_issue_url)
    elsif jira_or_github_issue_url.include?("github.com")
      branch_name = GithubApi.build_branch_name(jira_or_github_issue_url)
    else
      raise ScriptError, "Invalid issue URL: #{jira_or_github_issue_url}"
    end

    system("git checkout -b #{branch_name}")
  end

  ##
  # Fetches the description of a Jira issue and prints it to the console in markdown format.
  # Example:
  #   dev description-from https://yg-hpw.atlassian.net/browse/ELCC-61
  #
  # Produces:
  #   ... a bunch of markdown text ...
  def description_from(jira_issue_url, *args, **kwargs)
    description = JiraApi.fetch_description_as_markdown(jira_issue_url)
    puts description
  end

  def changes_from(branch_or_ref_or_commit_hash = "HEAD")
    system("git --no-pager log origin/main..#{branch_or_ref_or_commit_hash} --patch")
  end

  ##
  # Edits the description of a pull request.
  # Example:
  #   dev edit-pr https://github.com/icefoganalytics/travel-authorization/pull/218
  def edit_pr(pull_request_url, *args, **kwargs)
    PullRequestEditor.edit_pull_request_description(pull_request_url, *args, **kwargs)
    exit(0)
  end

  def ownit(*args, **kwargs)
    file_or_directory = args[0]
    raise ScriptError, "Must provide a file or directory path." if file_or_directory.nil?

    if RUBY_PLATFORM =~ /linux/
      puts "Take ownership of the file or directory? #{file_or_directory}"
      exec("sudo chown -R #{user_id}:#{group_id} #{file_or_directory}")
    else
      raise NotImplementedError, "Not implement for platform #{RUBY_PLATFORM}"
    end
  end

  ##
  # Generate bash completions for the dev command.
  def bash_completions
    all_public_methods = public_methods(false).sort
    all_public_methods.delete(:call)
    completions = all_public_methods.map { |word| METHOD_TO_COMMAND.fetch(word, word) }
    puts completions
  end

  ##
  # Generate help documentation.
  def help(*args, **kwargs)
    rdoc = RDoc::RDoc.new
    rdoc_arguments = %w[--dry-run --quiet] + [__FILE__]
    rdoc.document(rdoc_arguments)
    rdoc_data_for_class = rdoc.store.classes_hash["DevHelper"]

    puts <<~HELP.chomp
      Development Helper.

      Usage:
        dev <command> [args]

      Available commands:
    HELP

    all_public_methods = public_methods(false).sort
    all_public_methods.delete(:call)
    longest_command_length = all_public_methods.map(&:length).max

    all_public_methods.each do |method_name|
      method_doc = rdoc_data_for_class.find_method_named(method_name.to_s)
      command = METHOD_TO_COMMAND.fetch(method_name, method_name)
      comment = method_doc.comment

      print "  #{command}"
      unless comment.empty?
        first_line_of_comment = comment.to_s.lines[0].strip
        pad = "-" * (longest_command_length - command.length + 1)
        print " #{pad} #{first_line_of_comment}"
      end
      print "\n"
    end

    command = compose_command("<args>")
    puts "\nFallback for unknown commands is to run `#{command}`."
  end

  #######

  private

  #######

  def container_id(container_name, *args, **kwargs)
    command = compose_command(*%w[ps -q], container_name, *args, **kwargs)
    puts "Running: #{command}"
    id_of_container = `#{command}`.chomp
    puts "Container id is: #{id_of_container}"
    id_of_container
  end

  def ensure_development_ports!
    return if persisted_development_configuration_present? && (compose_project_running? || persisted_development_configuration_available?)

    servers = PORT_ENV_KEYS.to_h { |key| [key, TCPServer.new("127.0.0.1", 0)] }
    api_port = servers.fetch("TK_API_PORT").addr[1]
    web_host = development_web_host(api_port)
    stack_id = development_stack_id(api_port)

    File.write(
      port_env_file_path,
      (PORT_ENV_KEYS.map { |key| "#{key}=#{servers.fetch(key).addr[1]}" } + ["#{WEB_HOST_ENV_KEY}=#{web_host}", "#{STACK_ID_ENV_KEY}=#{stack_id}"]).join("\n") + "\n",
    )
    puts "Wrote development ports to #{port_env_file_path}"
  ensure
    servers&.each_value(&:close)
  end

  def compose_project_running?
    command = "cd #{project_root} && #{without_generated_development_environment} docker compose --env-file #{port_env_file_path} -f docker-compose.development.yml ps -q --status=running"

    !`#{command}`.strip.empty?
  end

  def persisted_development_configuration_available?
    return false unless persisted_development_configuration_present?

    persisted_development_ports.values_at(*PORT_ENV_KEYS).all? { |port| port_available?(port) }
  end

  def persisted_development_configuration_present?
    ports = persisted_development_ports
    api_port = ports["TK_API_PORT"]

    api_port &&
      persisted_web_host == development_web_host(api_port) &&
      persisted_stack_id == development_stack_id(api_port) &&
      ports.values_at(*PORT_ENV_KEYS).all? &&
      ports.values_at(*PORT_ENV_KEYS).uniq.length == PORT_ENV_KEYS.length
  end

  def persisted_development_ports
    development_environment.slice(*PORT_ENV_KEYS).to_h do |key, value|
      [key, Integer(value, 10)]
    rescue ArgumentError, TypeError
      [key, nil]
    end
  end

  def persisted_web_host
    development_environment[WEB_HOST_ENV_KEY]
  end

  def persisted_stack_id
    development_environment[STACK_ID_ENV_KEY]
  end

  def development_environment
    return {} unless File.exist?(port_env_file_path)

    File.readlines(port_env_file_path).each_with_object({}) do |line, environment|
      key, value = line.strip.split("=", 2)
      environment[key] = value if key && value
    end
  end

  def development_web_host(api_port)
    "#{development_stack_id(api_port)}#{WEB_HOST_SUFFIX}"
  end

  def development_stack_id(api_port)
    "traditional-knowledge-#{api_port}"
  end


  def port_available?(port)
    server = TCPServer.new("127.0.0.1", port)
    true
  rescue Errno::EADDRINUSE
    false
  ensure
    server&.close
  end

  def port_env_file_path
    "#{project_root}/#{PORT_ENV_FILE}"
  end

  def without_generated_development_environment
    "env #{(PORT_ENV_KEYS + [WEB_HOST_ENV_KEY, STACK_ID_ENV_KEY]).map { |key| "-u #{key}" }.join(" ")}"
  end

  def ensure_local_gateway!
    return if system("cd #{project_root} && env -u COMPOSE_PROJECT_NAME docker compose -p local-gateway -f docker-compose.local-gateway.yml up -d")

    raise ScriptError, "Unable to start the shared local gateway."
  end

  def gateway_needed?(args)
    requested_services = args & DEVELOPMENT_SERVICES

    requested_services.empty? || requested_services.include?("web")
  end

  def compose_command(*args, **kwargs)
    environment = kwargs.delete(:environment) { "development" }
    pipe_input = kwargs.delete(:pipe_input)

    go_to_project_root = "cd #{project_root}"
    compose_file_args = ["-f docker-compose.#{environment}.yml"]

    if RUBY_PLATFORM =~ /linux/
      linux_override = "docker-compose.#{environment}.linux.yml"
      linux_override_path = File.join(project_root, linux_override)
      compose_file_args << "-f #{linux_override}" if File.exist?(linux_override_path)
    end

    env_file = environment == "development" && File.exist?(port_env_file_path) ? "--env-file #{port_env_file_path}" : nil
    environment_prefix = environment == "development" ? "#{without_generated_development_environment} " : ""
    bootstrap_docker = "#{environment_prefix}docker compose #{[env_file, compose_file_args.join(' ')].compact.join(' ')} #{args.join(' ')}"

    if pipe_input
      shell_safe_pipe_input = Shellwords.escape(pipe_input)
      pipe_input_to_compose = "printf '%s\\n' #{shell_safe_pipe_input} |"

      <<~BASH
        #{go_to_project_root} && \
        #{pipe_input_to_compose} #{dynamic_environment_variables} #{bootstrap_docker}
      BASH
    else
      <<~BASH
        #{go_to_project_root} && \
        #{dynamic_environment_variables} #{bootstrap_docker}
      BASH
    end
  end

  def project_root
    @project_root ||= File.absolute_path("#{__dir__}/..")
  end

  def dynamic_environment_variables
    if RUBY_PLATFORM =~ /linux/ && user_id == '1000' && group_id == '1000'
      %(HOST_USER_ID="#{user_id}" HOST_GROUP_ID="#{group_id}")
    else
      ""
    end
  end

  def take_over_needed?(file_or_directory)
    files_owned_by_others =
      system("find #{file_or_directory} -not -user #{user_id} -print -quit | grep -q .")
    files_owned_by_others
  end

  def user_id
    unless RUBY_PLATFORM =~ /linux/
      raise NotImplementedError, "Not implement for platform #{RUBY_PLATFORM}"
    end

    `id -u`.strip
  end

  def group_id
    unless RUBY_PLATFORM =~ /linux/
      raise NotImplementedError, "Not implement for platform #{RUBY_PLATFORM}"
    end

    `id -g`.strip
  end

  def reformat_project_relative_path_filter_for_vitest!(args, prefix)
    src_path_prefix = "#{prefix}src/"
    test_path_regex = Regexp.escape(prefix)
    src_path_regex = Regexp.escape(src_path_prefix)

    reformatted = false
    args.each_with_index do |arg, index|
      next unless arg.start_with?(prefix)

      if arg.start_with?(src_path_prefix)
        args[index] = arg.gsub(/^#{src_path_regex}/, "tests/").gsub(/\.ts$/, ".test.ts")
      else
        args[index] = arg.gsub(/^#{test_path_regex}/, "")
      end

      reformatted = true
    end

    puts "Reformatted path filter from project relative to service relative for vitest." if reformatted
  end

  ##
  # Convert PlantUML file to PNG using local PlantUML server.
  def plantuml_to_png(*args, **kwargs)
    file_path = args.pop
    raise ScriptError, "Must provide a file path." if file_path.nil?

    png_path = file_path.gsub(/\. (wsd|pu|puml|plantuml|uml)$/, ".png")

    command = <<~BASH
      curl #{args.join(" ")} \
        --data-binary @'#{file_path}' \
        http://localhost:9999/png > '#{png_path}'
    BASH

    system(command)
    puts "Generated PNG: #{png_path}"
  end

  def service_running?(container_name)
    ps(*%w[-q --status=running], execution_mode: WAIT_FOR_PROCESS, slient: true) != ""
  end
end

# Only execute main function when file is executed
DevHelper.call(*ARGV) if $PROGRAM_NAME == __FILE__

## Dev completions
